generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String       @id
  name          String
  email         String       @unique
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @default(now()) @updatedAt
  courses       Course[]
  accounts      Account[]
  sessions      Session[]
  enrollment    Enrollment[]
  lessonProgress LessonProgress[]

  stripeCustomerId String? @unique

  role       String?  @default("user")
  banned     Boolean? @default(false)
  banReason  String?
  banExpires DateTime?

  bio      String?
  jobTitle String?

  reviews     Review[]
  certificates Certificate[]
  wishlist    Wishlist[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  impersonatedBy String?

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @default(now())
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now())

  @@map("verification")
}

model Course {
  id String @id @default(cuid())

  title            String
  description      String
  fileKey          String
  price            Int
  duration         Int
  level            CourseLevel @default(BEGINNER)

  /// Stripe price used for checkout. Optional so a course can be created
  /// before (or without) a Stripe account being connected.
  stripePriceId String? @unique

  category         String
  smallDescription String
  slug             String      @unique

  status CourseStatus @default(DRAFT)

  /// Short marketing tagline shown on cards and in the hero.
  subtitle String?
  /// Public preview video (object-storage key).
  trailerKey String?

  /// Denormalised aggregates. Kept in sync by the server actions so the
  /// catalogue can be rendered without a join-heavy aggregate query.
  averageRating Float @default(0)
  totalReviews  Int   @default(0)
  totalStudents Int   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  chapter    Chapter[]
  enrollment Enrollment[]
  reviews    Review[]
  wishlist   Wishlist[]
  certificates Certificate[]

  @@index([status, createdAt])
  @@index([category])
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Chapter {
  id String @id @default(uuid())

  title    String
  position Int

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId  String

  lessons Lesson[]

  @@index([courseId, position])
}

model Lesson {
  id String @id @default(uuid())

  title        String
  description  String?
  thumbnailKey String?
  videoKey     String?
  position     Int

  /// Free preview lessons are playable without an enrolment (Udemy model).
  isPreview Boolean @default(false)
  /// Length of the lesson in minutes, used for progress estimates.
  durationMinutes Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  chapterId String

  lessonProgress LessonProgress[]

  @@index([chapterId, position])
}

model Enrollment {
  id String @id @default(uuid())

  amount Int
  status EnrollmentStatus @default(Pending)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  /// Stripe checkout session that created this enrolment.
  checkoutSessionId String? @unique
  /// Amount refunded (in the smallest currency unit).
  refundedAmount Int @default(0)

  @@unique([courseId, userId])
  @@index([userId, status])
}

/// Per-lesson completion state for a learner.
model LessonProgress {
  id String @id @default(uuid())

  completed Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String?

  lesson Lesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId String?

  @@unique([userId, lessonId])
  @@index([userId])
}

/// A learner's rating + written feedback for a course.
model Review {
  id String @id @default(cuid())

  /// 1 – 5 stars.
  rating  Int
  title   String?
  comment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId String

  @@unique([userId, courseId])
  @@index([courseId, createdAt])
}

/// Certificate of completion, issued once a learner finishes every lesson.
model Certificate {
  id String @id @default(cuid())

  /// Human readable verification code, e.g. `UC-8F3K-2Q9M`.
  serial     String   @unique
  /// Final score snapshot at the time of issuance.
  finalScore Float    @default(0)
  issuedAt   DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId String

  @@unique([userId, courseId])
}

/// Saved-for-later list on a course.
model Wishlist {
  id String @id @default(cuid())

  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId String

  @@unique([userId, courseId])
}

/// Distributed rate-limit counters (replaces the previous paid WAF).
model RateLimit {
  id String @id

  key   String @unique
  count Int    @default(0)

  resetAt DateTime
  updatedAt DateTime @default(now()) @updatedAt

  @@index([resetAt])
}

enum EnrollmentStatus {
  Pending
  Active
  Cancelled
  Refunded
}
