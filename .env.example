# ---------------------------------------------------------------------------
# Ucademy — environment configuration
#
# Copy this file to `.env` and fill in the values.
#
# Only two variables are REQUIRED:
#   DATABASE_URL          — a Postgres connection string
#   BETTER_AUTH_SECRET    — a long random string (32+ characters)
#
# Every other integration is OPTIONAL. When a provider is not configured the
# matching feature is disabled instead of breaking the build:
#   - No Stripe  -> courses can be created but not sold
#   - No Resend  -> email sign-in is unavailable
#   - No S3      -> media uploads are unavailable
#   - No GitHub  -> the GitHub button is hidden
# ---------------------------------------------------------------------------

# --- Core (required) -------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"

# Canonical origin of the deployment. Used for OAuth callbacks, Stripe
# redirects, metadata and the sitemap.
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- GitHub sign-in (optional) --------------------------------------------
# Create an OAuth app at https://github.com/settings/developers and set the
# callback URL to <BETTER_AUTH_URL>/api/auth/callback/github
AUTH_GITHUB_CLIENT_ID=""
AUTH_GITHUB_SECRET=""

# --- Email delivery (optional) --------------------------------------------
# Resend API key: https://resend.com/api-keys
RESEND_API_KEY=""
# A verified sender. Resend's onboarding@resend.dev only delivers to the
# account owner, so use your own domain for production.
RESEND_FROM_EMAIL="Ucademy <onboarding@resend.dev>"

# --- Object storage (optional) --------------------------------------------
# Any S3-compatible provider: AWS S3, Cloudflare R2, MinIO, T3 Storage.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_ENDPOINT_URL_S3="https://t3.storage.dev"
AWS_REGION="us-east-1"
# true for path-style providers (T3, R2, MinIO), false for AWS S3
AWS_S3_FORCE_PATH_STYLE="false"
# The bucket that serves the course thumbnails and lesson videos.
NEXT_PUBLIC_S3_BUCKET_NAME_IMAGES="ucademy"
# Public base URL of the bucket. Defaults to
# https://<NEXT_PUBLIC_S3_BUCKET_NAME_IMAGES>.t3.storage.dev
NEXT_PUBLIC_STORAGE_BASE_URL=""

# --- Payments (optional) ---------------------------------------------------
# Stripe secret + webhook keys: https://dashboard.stripe.com
# The webhook endpoint is <BETTER_AUTH_URL>/api/webhook/stripe and must
# listen for: checkout.session.completed, checkout.session.expired,
# charge.refunded
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- Misc ------------------------------------------------------------------
# Set to 1 to skip environment validation (used in CI / container builds).
# SKIP_ENV_VALIDATION=1
